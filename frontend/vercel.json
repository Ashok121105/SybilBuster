{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${VITE_API_URL}/api/$1",
      "env": ["VITE_API_URL"],
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "origin"
          }
        }
      ]
    },
    { "handle": "filesystem" }
  ]
}